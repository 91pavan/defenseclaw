{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "defenseclaw-prometheus"
        },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\"}",
        "iconColor": "red",
        "name": "Firing alerts",
        "titleFormat": "{{alertname}}"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Tool calls",
      "datasource": {
        "type": "prometheus",
        "uid": "defenseclaw-prometheus"
      },
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum by (tool_name) (rate(defenseclaw_tool_calls_total[$__rate_interval])) or vector(0)", "legendFormat": "{{tool_name}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Tool calls Error",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum by (tool_name) (rate(defenseclaw_tool_errors_total[$__rate_interval])) or vector(0)", "legendFormat": "{{tool_name}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Tool call duration",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 6},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, tool_name) (rate(defenseclaw_tool_duration_milliseconds_bucket[$__rate_interval]))) or vector(0)", "legendFormat": "{{tool_name}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}
    },

    {
      "type": "timeseries",
      "title": "Memory Read events",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 0, "y": 6, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(rate(defenseclaw_tool_calls_total{tool_name=~\"memory.read|memory_read|memory-read|memory_get|memory.retrieve\"}[$__rate_interval])) or vector(0)", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Memory Write events",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 8, "y": 6, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(rate(defenseclaw_tool_calls_total{tool_name=~\"memory.write|memory_write|memory-save|memory.upsert\"}[$__rate_interval])) or vector(0)", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Memory Edit events",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 16, "y": 6, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(rate(defenseclaw_tool_calls_total{tool_name=~\"memory.edit|memory_edit|memory.update|memory.patch\"}[$__rate_interval])) or vector(0)", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },

    {
      "type": "timeseries",
      "title": "Memory Search Hit",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 0, "y": 12, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(rate(defenseclaw_tool_calls_total{tool_name=~\"memory.search|memory_search\"}[$__rate_interval])) or vector(0)", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Memory Search Miss",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 8, "y": 12, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(rate(defenseclaw_tool_errors_total{tool_name=~\"memory.search|memory_search\"}[$__rate_interval])) or vector(0)", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Search events",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 16, "y": 12, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(rate(defenseclaw_tool_calls_total{tool_name=~\".*search.*\"}[$__rate_interval])) or vector(0)", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },

    {
      "type": "timeseries",
      "title": "Session Parallelisation and Efficiency Score",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 0, "y": 18, "w": 11, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket[$__rate_interval]))) or vector(0)", "legendFormat": "p95 latency", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Session Repetition  Score",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 11, "y": 18, "w": 13, "h": 8},
      "targets": [
        {"expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_count[$__rate_interval])) or vector(0)", "legendFormat": "{{gen_ai_request_model}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },

    {
      "type": "timeseries",
      "title": "Agent Context Preparation duration",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 0, "y": 26, "w": 8, "h": 6},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket[$__rate_interval]))) or vector(0)", "legendFormat": "p50", "refId": "A"}
