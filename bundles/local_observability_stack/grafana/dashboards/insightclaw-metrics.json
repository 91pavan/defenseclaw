        {"expr": "sum(rate(gen_ai_client_operation_duration_seconds_count[$__rate_interval])) or vector(0)", "legendFormat": "operations", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Context source - Memory history",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 8, "y": 38, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(rate(defenseclaw_tool_calls_total{tool_name=~\"memory.*\"}[$__rate_interval])) or vector(0)", "legendFormat": "memory tools", "refId": "A"}
