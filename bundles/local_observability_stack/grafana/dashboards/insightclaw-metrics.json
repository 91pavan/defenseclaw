  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["defenseclaw", "insightclaw", "openclaw", "compat"],
  "templating": {
    "list": [
      {
        "name": "groupby",
        "type": "custom",
        "query": "session.id,gen_ai.agent.id,gen_ai_request_model,tool_name",
        "current": {
          "text": "gen_ai_request_model",
          "value": "gen_ai_request_model"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "timezone": "browser",
  "title": "OpenClaw Metrics dashboard",
