        {"expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_token_usage_sum{gen_ai_token_type=~\"input|prompt\"}[$__rate_interval])) or vector(0)", "legendFormat": "{{gen_ai_request_model}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },

    {
      "type": "timeseries",
      "title": "Context source - Tool history",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 0, "y": 32, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum by (tool_name) (rate(defenseclaw_tool_calls_total[$__rate_interval])) or vector(0)", "legendFormat": "{{tool_name}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Context source - User history",
