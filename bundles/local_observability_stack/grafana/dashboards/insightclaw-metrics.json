    {
      "type": "timeseries",
      "title": "Downstream context propagation - smoothed",
      "datasource": {"type": "prometheus", "uid": "defenseclaw-prometheus"},
      "gridPos": {"x": 0, "y": 60, "w": 8, "h": 8},
